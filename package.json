{
  "name": "strava-stateless",
  "version": "0.1.0",
  "description": "A stateless Strava MCP relay with no deployment secrets",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || 24.x"
  },
  "scripts": {
    "prepare": "npm run build:web",
    "build:css": "tailwindcss -i web/styles.css -o .generated/styles.css --minify",
    "build:web": "npm run build:css && node scripts/build-web.ts",
    "pretest": "npm run build:web",
    "test": "node --test test.ts *.test.ts",
    "test:runtime": "npm run check:cloudflare && node --test tests/runtime.test.ts",
    "test:browser": "npm run build:web && node --test tests/browser.test.ts",
    "pretypecheck": "npm run build:web",
    "typecheck": "tsc --noEmit",
    "typecheck:workers": "wrangler types .wrangler/worker-configuration.d.ts --env-interface CloudflareEnv && tsc -p tsconfig.worker.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run typecheck:workers && npm run lint && npm run format:check && npm test && npm run test:runtime",
    "dev": "wrangler dev --local --local-protocol https --ip 127.0.0.1",
    "check:cloudflare": "wrangler deploy --dry-run --outdir dist/cloudflare",
    "build:sites": "wrangler deploy --dry-run --outdir dist/sites && node scripts/prepare-sites.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "miniflare": "5.20260907.0-alpha",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "wrangler": "4.129.1"
  },
  "cloudflare": {
    "bindings": {
      "CLIENT_ID": {
        "description": "Public OAuth client ID. Defaults to ChatGPT's client metadata URL; no client secret is needed."
      },
      "REDIRECT_URI": {
        "description": "One exact HTTPS OAuth callback URL. The default matches ChatGPT's stable client metadata. No wildcards or lists."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
